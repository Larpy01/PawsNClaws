@model PawsNClaws.Local.Models.Products.ProductListModel
@using PawsNClaws.Infastructure.Identity.Local
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Products";
    var canCreate = (await AuthorizationService.AuthorizeAsync(
        User, Permissions.ProductsCreate)).Succeeded;

    var canUpdate = (await AuthorizationService.AuthorizeAsync(
        User, Permissions.ProductsUpdate)).Succeeded;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Product Management</h2>
        <p class="text-muted mb-0">
            Manage products available for sale.
        </p>
    </div>

    @if (canCreate)
    {
        <a asp-action="Create" class="btn btn-primary">
            Add Product
        </a>
    }
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success" role="status">
        @success
    </div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">
        @error
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>SKU</th>
                        <th>Product Name</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Products.Count == 0)
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center text-muted py-4">
                                No products found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var product in Model.Products)
                        {
                            <tr>
                                <td>@product.SKU</td>
                                <td>@product.Name</td>
                                <td>
                                    ₱@product.Price.ToString("N2")
                                </td>
                                <td>
                                    @if (product.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }
                                </td>
                                <td>
                                    @product.CreatedAtUtc.ToString("yyyy-MM-dd")
                                </td>
                                <td class="text-end">
                                    @if (canUpdate)
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@product.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
