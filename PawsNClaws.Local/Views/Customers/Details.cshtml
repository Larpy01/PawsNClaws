@model PawsNClaws.Application.Features.Customers.CustomerProfile
@{
    ViewData["Title"] = "Customer profile";
}
<a asp-action="Index">Customers &amp; Pets</a>
<h1>@Model.Details.FirstName @Model.Details.LastName</h1>
<dl>
    <dt>Contact number</dt><dd>@(Model.Details.Phone ?? "Unknown")</dd>
    <dt>Email</dt><dd>@(Model.Details.Email ?? "Unknown")</dd>
    <dt>Address</dt><dd>@(Model.Details.Address ?? "Unknown")</dd>
    <dt>Owner consent on record</dt><dd>@(Model.Details.RecordConsent ? "Yes" : "No")</dd>
</dl>
<a href="@Url.Content($"~/Customers/{Model.Id}/Edit")">Edit customer</a>
<h2 class="mt-4">Pets</h2>
<a href="@Url.Content($"~/Customers/{Model.Id}/Pets/New")" class="btn btn-primary">Add pet</a>
@if (Model.Pets.Count == 0)
{
    <p class="mt-3">No pets recorded for this customer.</p>
}
@foreach (var pet in Model.Pets)
{
    <section class="card card-body mt-3">
        <h3>@pet.Details.Name</h3>
        <dl>
            <dt>Species</dt><dd>@(pet.Details.Species ?? "Unknown")</dd>
            <dt>Breed</dt><dd>@(pet.Details.Breed ?? "Unknown")</dd>
            <dt>Sex</dt><dd>@(pet.Details.Sex ?? "Unknown")</dd>
            <dt>Date Of Birth</dt><dd>@(pet.Details.DateOfBirth?.ToString("yyyy-MM-dd") ?? "Unknown")</dd>
            <dt>Size</dt><dd>@(pet.Details.Size ?? "Unknown")</dd>
            <dt>Weight (kg)</dt><dd>@(pet.Details.WeightKg?.ToString("0.###") ?? "Unknown")</dd>
            <dt>Vaccination Status</dt><dd>@(pet.Details.VaccinationStatus ?? "Unknown")</dd>
            <dt>Allergies</dt><dd>@(pet.Details.Allergies ?? "Unknown")</dd>
            <dt>Medical Notes</dt><dd>@(pet.Details.MedicalNotes ?? "Unknown")</dd>
            <dt>Behavior Notes</dt><dd>@(pet.Details.BehaviorNotes ?? "Unknown")</dd>
            <dt>Special Instructions</dt><dd>@(pet.Details.SpecialInstructions ?? "Unknown")</dd>
        </dl>
        <a href="@Url.Content($"~/Customers/{Model.Id}/Pets/{pet.Id}/Edit")">Edit @pet.Details.Name</a>
    </section>
}
