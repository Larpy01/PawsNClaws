@model IReadOnlyList<PawsNClaws.Application.Features.Customers.CustomerRow>
@{
    ViewData["Title"] = "Customers & Pets";
    var pageNumber = (int)ViewData["Page"]!;
    var query = ViewData["Query"] as string;
}
<div class="workspace-page-heading">
    <h1>Customers &amp; Pets</h1>
    <a href="@Url.Content("~/Customers/New")" class="btn btn-primary">Add customer</a>
</div>
<form method="get" class="my-3">
    <label for="query" class="form-label">Search by customer, contact number, email, or pet name</label>
    <div class="input-group">
        <input id="query" name="query" value="@query" class="form-control" />
        <button class="btn btn-outline-primary">Search</button>
    </div>
</form>
@if (Model.Count == 0)
{
    <p class="my-3">No customers found.</p>
}
else
{
    <div class="table-responsive mt-3" tabindex="0" role="region" aria-label="Customer search results">
        <table class="table">
            <thead><tr><th scope="col">Customer</th><th scope="col">Contact number</th><th scope="col">Email</th></tr></thead>
            <tbody>
            @foreach (var owner in Model.Take(25))
            {
                <tr><td><a asp-action="Details" asp-route-id="@owner.Id">@owner.FirstName @owner.LastName</a></td><td>@owner.Phone</td><td>@owner.Email</td></tr>
            }
            </tbody>
        </table>
    </div>
}
@if (pageNumber > 1)
{
    <a asp-action="Index" asp-route-page="@(pageNumber - 1)" asp-route-query="@query">Previous page</a>
}
@if (Model.Count > 25)
{
    <a asp-action="Index" asp-route-page="@(pageNumber + 1)" asp-route-query="@query">Next page</a>
}
