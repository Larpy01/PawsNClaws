@model PawsNClaws.Application.Features.Customers.CustomerForm
@{
    var heading = Model.Version == Guid.Empty ? "Add customer" : "Edit customer";
    ViewData["Title"] = heading;
}
<h1>@heading</h1>

<form method="post" class="col-lg-7">
    @Html.AntiForgeryToken()
    <input asp-for="Version" type="hidden" />
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" maxlength="100" required />
    </div>
    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" maxlength="100" required />
    </div>
    <div class="mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" maxlength="40" />
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" maxlength="256" />
    </div>
    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <textarea asp-for="Address" class="form-control" maxlength="400"></textarea>
    </div>
    <div class="form-check my-3">
        <input asp-for="RecordConsent" class="form-check-input" />
        <label asp-for="RecordConsent" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Save customer</button>
</form>
