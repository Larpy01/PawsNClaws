<!DOCTYPE html>
@{
    var workspace = User.Identity?.IsAuthenticated == true && ViewData["HideHeader"] is not true;
    var shellTheme = Context.Request.Cookies["workspace_theme"] == "dark" ? "dark" : "light";
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Paws N’ Claws</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/typography.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PawsNClaws.Local.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    @if (workspace)
    {
        <link rel="stylesheet" href="~/css/shell.css" asp-append-version="true" />
    }
</head>
<body class="@(workspace ? "workspace-body" : null)">
    @if (workspace)
    {
        <a class="visually-hidden-focusable workspace-skip" href="#main-content">Skip to content</a>
        <div class="shell-frame" data-shell-theme="@shellTheme"
             data-sidebar-expanded="@((Context.Request.Cookies["sidebar_state"] == "true").ToString().ToLowerInvariant())">
            <partial name="_WorkspaceSidebar" />
            <main id="main-content" class="workspace-content" tabindex="-1">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main id="main-content" class="container pb-3">
            @RenderBody()
        </main>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (workspace)
    {
        <script src="~/js/shell.js" asp-append-version="true" defer></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
