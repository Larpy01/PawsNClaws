
@model PawsNClaws.Application.Features.Employees.DTOs.EmployeeAuditLogPageDto

@{
    ViewData["Title"] = "Employee Audit Logs";
    var totalPages = (int)Math.Ceiling(
        (double)Model.TotalCount / Model.PageSize);
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Employee Audit Logs</h2>

        <a asp-controller="Employees"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Employees
        </a>
    </div>

    <p class="text-muted">
        Total records: @Model.TotalCount
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Action</th>
                    <th>Administrator ID</th>
                    <th>Employee ID</th>
                    <th>Previous Value</th>
                    <th>New Value</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Items)
                {
                    <tr>
                        <td>
                            @PhilippineDateTime.FormatUtc(log.CreatedAtUtc)
                        </td>
                        <td>@log.Action</td>
                        <td>
                            <small>@log.ActorUserId</small>
                        </td>
                        <td>
                            <small>@log.TargetUserId</small>
                        </td>
                        <td>@(log.OldValue ?? "—")</td>
                        <td>@(log.NewValue ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Items.Any())
    {
        <p class="text-muted">
            No audit records found on this page.
        </p>
    }

    <nav aria-label="Audit log pagination">
        <div class="d-flex gap-2 align-items-center">
            @if (Model.Page > 1)
            {
                <a asp-action="Index"
                   asp-route-page="@(Model.Page - 1)"
                   class="btn btn-outline-primary">
                    Previous
                </a>
            }

            <span>
                Page @Model.Page of @Math.Max(1, totalPages)
            </span>

            @if (Model.Page < totalPages)
            {
                <a asp-action="Index"
                   asp-route-page="@(Model.Page + 1)"
                   class="btn btn-outline-primary">
                    Next
                </a>
            }
        </div>
    </nav>
</div>
