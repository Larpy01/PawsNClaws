@model PawsNClaws.Local.Models.Authentication.TechnicalLoginModel
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SuperAdmin sign-in | Paws N' Claws</title>
    <link rel="stylesheet" href="~/css/technical-login.css" asp-append-version="true" />
</head>
<body>
    <main>
        <h1>SuperAdmin sign-in</h1>
        <form asp-controller="TechnicalAccount" asp-action="Login" method="post">
            <div asp-validation-summary="All" class="errors" role="alert"></div>
            <label asp-for="Email">Email address</label>
            <input asp-for="Email" autocomplete="username" required />
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="current-password" required />
            <button type="submit">Sign in</button>
        </form>
        <footer><a asp-controller="Account" asp-action="Login">Employee sign-in</a></footer>
    </main>
</body>
</html>
