@model DashboardViewModel
@using Microsoft.AspNetCore.Authorization
@using PawsNClaws.Infastructure.Identity.Local
@inject IAuthorizationService AuthorizationService
@{ ViewData["Title"] = "Employee Dashboard"; }
<section class="workspace-page-heading">
    <div>
        <h1>@(Model.Operations is null ? "My workspace" : "Shop overview")</h1>
        <p>Welcome, @Model.EmployeeName.</p>
    </div>
    @if (Model.Operations is not null)
    {
        <a asp-controller="OperationsReports" asp-action="Index" class="btn btn-outline-primary">Operations reports</a>
    }
</section>
@if (Model.Operations is { } operations)
{
    <div class="workspace-kpis" role="group" aria-label="Shop summary">
        <article class="workspace-panel"><h2>Appointments today</h2><strong>@operations.TodayAppointments.ToString("N0")</strong></article>
        <article class="workspace-panel"><h2>Pickups today</h2><strong>@operations.TodayPickups.ToString("N0")</strong></article>
        <article class="workspace-panel"><h2>Walk-ins waiting today</h2><strong>@operations.OpenWalkIns.ToString("N0")</strong></article>
        <article class="workspace-panel"><h2>Gross retail sales</h2><strong>₱@((operations.CashSales + operations.OnlineSales).ToString("N2"))</strong><small>Last 7 days</small></article>
    </div>
    <div class="workspace-insights">
        <partial name="_DashboardTrend" model='new DashboardTrend("Grooming activity", "Appointments", "Pickups", operations.Days)' />
        <partial name="_DashboardMix" model='new DashboardMix("Retail sales by payment", "Cash", "Online", operations.CashSales, operations.OnlineSales, "₱{0:N2}", "Last 7 days · Before refunds")' />
    </div>
    <section class="workspace-panel workspace-quick">
        <h2>Shop tasks</h2>
        <div>
            @if ((await AuthorizationService.AuthorizeAsync(User, Permissions.CustomerRecordsManage)).Succeeded)
            {
                <a asp-controller="GroomingAppointments" asp-action="Index" class="btn btn-primary">View appointments</a>
            }
            @if ((await AuthorizationService.AuthorizeAsync(User, Permissions.InventoryView)).Succeeded)
            {
                <a asp-controller="Inventory" asp-action="Alerts" class="btn btn-outline-primary">Review inventory alerts</a>
            }
            @if ((await AuthorizationService.AuthorizeAsync(User, Permissions.UsersView)).Succeeded)
            {
                <a asp-controller="Employees" asp-action="Index" class="btn btn-outline-primary">Manage employees</a>
            }
        </div>
    </section>
}
else
{
    <section class="workspace-panel workspace-quick">
        <h2>Start work</h2>
        <div>
            @if (User.IsInRole(LocalRoles.Groomer))
            {
                <a asp-controller="GroomerTasks" asp-action="Index" class="btn btn-primary">My grooming tasks</a>
            }
            @if ((await AuthorizationService.AuthorizeAsync(User, Permissions.PosAccess)).Succeeded &&
                 (await AuthorizationService.AuthorizeAsync(User, Permissions.PosCreateSale)).Succeeded)
            {
                <a asp-controller="RetailCheckout" asp-action="Index" class="btn btn-primary">Start retail checkout</a>
            }
            @if ((await AuthorizationService.AuthorizeAsync(User, Permissions.CustomerRecordsManage)).Succeeded)
            {
                <a asp-controller="WalkInQueue" asp-action="Index" class="btn btn-outline-primary">Open walk-in queue</a>
            }
            @if ((await AuthorizationService.AuthorizeAsync(User, Permissions.InventoryView)).Succeeded)
            {
                <a asp-controller="Inventory" asp-action="Index" class="btn btn-outline-primary">Open inventory</a>
            }
        </div>
    </section>
}
