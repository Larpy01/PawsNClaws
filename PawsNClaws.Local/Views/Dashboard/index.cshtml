@model PawsNClaws.Local.Models.DashboardViewModel
@using PawsNClaws.Infastructure.Identity.Local
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Employee Dashboard";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Employee Dashboard</h2>
            <p class="text-muted">
                Welcome, @Model.EmployeeName
            </p>
            <span class="badge bg-secondary">
                @string.Join(", ", Model.Roles)
            </span>
        </div>

        <form asp-controller="Account"
              asp-action="Logout"
              method="post">
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-outline-danger">
                Logout
            </button>
        </form>
    </div>

    @if (User.IsInRole(LocalRoles.Groomer))
    {
        <p><a asp-controller="GroomerTasks" asp-action="Index" class="btn btn-primary">My grooming tasks</a></p>
    }
    <div class="row g-3">
        @if ((await AuthorizationService.AuthorizeAsync(User, Permissions.GroomingCatalogManage)).Succeeded)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5>Grooming Services</h5>
                        <p class="text-muted">Set up services, durations, and pet eligibility.</p>
                        <a asp-controller="GroomingCatalog" asp-action="Index" class="btn btn-primary">Open grooming catalog</a>
                        <a asp-controller="OffsiteBookings" asp-action="Index" class="btn btn-outline-primary">Open off-site requests</a>
                    </div>
                </div>
            </div>
        }
        @if ((await AuthorizationService.AuthorizeAsync(User, Permissions.CustomerRecordsManage)).Succeeded)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5>Customers &amp; Pets</h5>
                        <p class="text-muted">Find an owner, register a walk-in, or update a pet profile.</p>
                        <a asp-controller="Customers" asp-action="Index" class="btn btn-primary">Open customer records</a>
                        <a asp-controller="WalkInQueue" asp-action="Index" class="btn btn-outline-primary">Open walk-in queue</a>
                        <a asp-controller="GroomingAppointments" asp-action="Index" class="btn btn-outline-primary">Open grooming appointments</a>
                    </div>
                </div>
            </div>
        }

        @if (User.HasClaim("Permission", Permissions.PosAccess))
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5>Point of Sale</h5>
                        <p class="text-muted">Review grooming bills and record cash payments.</p>
                        <a asp-controller="VisitBilling" asp-action="Index" class="btn btn-primary">Open grooming bills</a>
                        <a asp-controller="RetailCheckout" asp-action="Index" class="btn btn-outline-primary">Open retail checkout</a>
                        <a asp-controller="CashDrawer" asp-action="Index" class="btn btn-outline-primary">Open cash drawer</a>
                    </div>
                </div>
            </div>
        }

        @if (User.HasClaim("Permission", Permissions.InventoryView))
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5>Inventory</h5>
                        <p class="text-muted">
                            Receive stock, review batches, and track stock movements.
                        </p>
                        <a asp-controller="Inventory" asp-action="Index" class="btn btn-primary">Open Inventory</a>
                        @if (User.IsInRole(LocalRoles.Admin) || User.IsInRole(LocalRoles.Manager))
                        {
                            <a asp-controller="Inventory" asp-action="Alerts" class="btn btn-outline-primary">Inventory alerts</a>
                        }
                    </div>
                </div>
            </div>
        }

        @if ((await AuthorizationService.AuthorizeAsync(User, Permissions.ProductsView)).Succeeded)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5>Products</h5>
                        <p class="text-muted">Browse the product catalog.</p>
                        <a asp-controller="Products" asp-action="Index" class="btn btn-primary">View Products</a>
                    </div>
                </div>
            </div>
        }

        @if ((User.IsInRole(LocalRoles.Admin) || User.IsInRole(LocalRoles.Manager)) && (await AuthorizationService.AuthorizeAsync(User, Permissions.ReportsView)).Succeeded)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5>Reports</h5>
                        <a asp-controller="OperationsReports" asp-action="Index" class="btn btn-primary">Open operations report</a>
                    </div>
                </div>
            </div>
        }

        @if ((await AuthorizationService.AuthorizeAsync(User, Permissions.UsersView)).Succeeded)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5>Employee Management</h5>
                        <p class="text-muted">
                            Manage employee accounts.
                        </p>
                        <a asp-controller="Employees" asp-action="Index" class="btn btn-primary">Manage Employees</a>
                        @if (User.IsInRole(LocalRoles.Admin))
                        {
                            <a asp-controller="EmployeeAuditLogs" asp-action="Index" class="btn btn-outline-secondary">View audit log</a>
                        }
                    </div>
                </div>
            </div>
        }

    </div>
</div>
