@model PawsNClaws.Local.Models.DashboardViewModel
@using PawsNClaws.Infastructure.Identity.Local

@{
    ViewData["Title"] = "Employee Dashboard";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Employee Dashboard</h2>
            <p class="text-muted">
                Welcome, @Model.EmployeeName
            </p>
            <span class="badge bg-secondary">
                @string.Join(", ", Model.Roles)
            </span>
        </div>

        <form asp-controller="Account"
              asp-action="Logout"
              method="post">
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-outline-danger">
                Logout
            </button>
        </form>
    </div>

    <div class="row g-3">

        @if (User.HasClaim("Permission", Permissions.PosAccess))
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5>Point of Sale</h5>
                        <p class="text-muted">
                            Process customer purchases.
                        </p>
                        <span class="badge bg-info text-dark">
                            Coming Soon
                        </span>
                    </div>
                </div>
            </div>
        }

        @if (User.HasClaim("Permission", Permissions.InventoryView))
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5>Inventory</h5>
                        <p class="text-muted">
                            Manage products and stock.
                        </p>
                        <span class="badge bg-info text-dark">
                            Coming Soon
                        </span>
                    </div>
                </div>
            </div>
        }

        @if (User.HasClaim("Permission", Permissions.ReportsView))
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5>Reports</h5>
                        <p class="text-muted">
                            View business performance.
                        </p>
                        <span class="badge bg-info text-dark">
                            Coming Soon
                        </span>
                    </div>
                </div>
            </div>
        }

        @if (User.HasClaim("Permission", Permissions.UsersView))
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5>Employee Management</h5>
                        <p class="text-muted">
                            Manage employee accounts.
                        </p>
                        <span class="badge bg-info text-dark">
                            <a asp-controller="Employees"
                               asp-action="Index"
                               class="btn btn-primary">
                                Manage Employees
                            </a>
                        </span>
                    </div>
                </div>
            </div>
        }

    </div>
</div>
