
@model PawsNClaws.Local.Models.Employees.EmployeeListModel
@using PawsNClaws.Infastructure.Identity.Local

@{
    ViewData["Title"] = "Employee Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Employee Management</h2>

        @if (User.HasClaim("Permission", Permissions.UsersCreate)
            && (User.IsInRole(LocalRoles.SuperAdmin)
                || User.IsInRole(LocalRoles.Admin)))
        {
            <a asp-action="Create"
               class="btn btn-primary">
                Add Employee
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="alert alert-success">
            @message
        </div>
    }

    <div class="table-responsive">

        @if (TempData["ErrorMessage"] is string error)
        {
            <div class="alert alert-danger" role="alert">
                @error
            </div>
        }

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var employee in Model.Employees)
                {
                    <tr>
                        <td>
                            @employee.FirstName @employee.LastName
                        </td>
                        <td>@employee.Email</td>
                        <td>@string.Join(", ", employee.Roles)</td>
                        <td>
                            @if (employee.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>        
                        <td>
                            @if (User.HasClaim(
                                    "Permission", Permissions.UsersAssignRoles)
                                && (User.IsInRole(LocalRoles.SuperAdmin)
                                    || User.IsInRole(LocalRoles.Admin))
                                && employee.Id.ToString() !=
                                    User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                                && !employee.Roles.Contains(LocalRoles.SuperAdmin))
                            {
                                <form asp-controller="Employees"
                                      asp-action="SetStatus"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@employee.Id" />

                                    <input type="hidden"
                                           name="isActive"
                                           value="@(employee.IsActive ? "false" : "true")" />

                                    <button type="submit"
                                            class="btn btn-sm @(employee.IsActive
                                                ? "btn-outline-danger"
                                                : "btn-outline-success")">
                                        @(employee.IsActive
                                            ? "Deactivate"
                                            : "Activate")
                                    </button>
                                </form>
                            }
                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
