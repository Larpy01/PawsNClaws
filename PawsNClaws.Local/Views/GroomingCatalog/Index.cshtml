@model IReadOnlyList<PawsNClaws.Application.Features.Grooming.GroomingCatalogEntry>
@{
    ViewData["Title"] = "Grooming Services";
}
<h1>Grooming Services</h1>
<a asp-route="NewGroomingService" class="btn btn-primary">Add service</a>
<a asp-controller="GroomingPlanning" asp-action="Index" class="btn btn-outline-primary">Packages, prices, price estimates and supplies</a>

@if (Model.Count == 0)
{
    <p class="mt-3">No grooming services have been configured.</p>
}
else
{
    <div class="table-responsive mt-3">
        <table class="table align-middle">
            <thead><tr><th>Service</th><th>Duration</th><th>Applies to</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
            @foreach (var entry in Model)
            {
                var service = entry.Service;
                <tr>
                    <td>@service.Name</td>
                    <td>@(service.DurationMinutes is int duration ? $"{duration} min" : "Unspecified")</td>
                    <td>@(service.Species ?? "All species") · @(service.Breed ?? "All breeds") · @(service.Size ?? "All sizes")</td>
                    <td>@(service.IsActive ? "Active" : "Inactive")</td>
                    <td><a asp-route="EditGroomingService" asp-route-id="@entry.Id" aria-label="Edit @service.Name">Edit</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
