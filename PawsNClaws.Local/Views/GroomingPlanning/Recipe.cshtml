@using PawsNClaws.Application.Features.Grooming
@model GroomingRecipeForm
@{
    ViewData["Title"] = "Service supply estimate";
    var options = (IReadOnlyList<PlanningOption>)ViewData["Options"]!;
    var products = (IReadOnlyList<PlanningOption>)ViewData["Products"]!;
}
<h1>Service supply estimate</h1>
<form method="post" class="col-lg-7">
    @Html.AntiForgeryToken()
    <input asp-for="Version" type="hidden" />
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="ServiceId" class="form-label"></label>
        <select asp-for="ServiceId" class="form-select">
            <option value="">Choose an option</option>
            @foreach (var option in options)
            {
                <option value="@option.Id">@option.Label@(!option.Available ? " (unavailable)" : "")</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="ProductId" class="form-label"></label>
        <select asp-for="ProductId" class="form-select">
            <option value="">Choose an option</option>
            @foreach (var option in products)
            {
                <option value="@option.Id">@option.Label@(!option.Available ? " (unavailable)" : "")</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" type="number" min="0.001" step="0.001" />
    </div>
    <p class="form-text">Enter how much of this supply one service usually uses. Use the unit shown next to the supply name.</p>
    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">Active</label>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
