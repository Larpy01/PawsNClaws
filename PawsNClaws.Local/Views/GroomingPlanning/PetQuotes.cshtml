@using PawsNClaws.Application.Features.Grooming
@model IReadOnlyList<QuoteVersion>
@{
    ViewData["Title"] = "Pet price estimates";
    var pet = (PlanningOption)ViewData["Pet"]!;
}
<h1>Grooming price estimates</h1>
<p>@pet.Label</p>
<a asp-action="Quote" asp-route-petId="@pet.Id" class="btn btn-primary">Create price estimate</a>
@if (Model.Count == 0)
{
    <p class="mt-3">No price estimates have been saved for this pet.</p>
}
else
{
    <ul class="list-group my-3">
    @foreach (var quote in Model)
    {
        <li class="list-group-item">
            <a asp-action="History" asp-route-id="@quote.Id">@quote.Snapshot.Lines[0].Name</a>
            <span>· Version @quote.Number · ₱@quote.Snapshot.Total.ToString("N2")</span>
        </li>
    }
    </ul>
}
