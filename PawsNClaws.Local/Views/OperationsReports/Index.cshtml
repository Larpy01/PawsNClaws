@using System.Globalization
@model OperationsReportPage
@{
    ViewData["Title"] = "Operations report";
    var date = Model.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
}
<h1>Operations report</h1>
<div class="report-actions mb-3">
    <form method="get" asp-action="Index" class="row g-2 align-items-end mb-2">
        <div class="col-sm-auto">
            <label class="form-label" for="report-date">Date</label>
            <input class="form-control" type="date" id="report-date" name="date" value="@date" required />
        </div>
        <div class="col-sm-auto">
            <label class="form-label" for="report-period">Period</label>
            <select class="form-select" id="report-period" name="monthly">
                <option value="false" selected="@(!Model.Monthly)">Day</option>
                <option value="true" selected="@Model.Monthly">Month</option>
            </select>
        </div>
        <div class="col-sm-auto"><button class="btn btn-primary">Show report</button></div>
    </form>
    <a asp-action="Export" asp-route-date="@date" asp-route-monthly="@Model.Monthly" class="btn btn-outline-primary">Download PDF</a>
    <a asp-action="Sms" class="btn btn-outline-secondary">SMS delivery queue</a>
</div>
<p>@Model.FirstDay.ToString("MMM d, yyyy")@if (Model.LastDay != Model.FirstDay) { <span> to @Model.LastDay.ToString("MMM d, yyyy")</span> } · Philippine time · Local shop records</p>

<h2 class="h5">Sales, payments, and drawer variances</h2>
<p>Grooming bills and cash received are tracked separately. Deposits show the amount verified in this period. Retail refunds appear on the date they were recorded.</p>
<table class="table">
    <thead><tr><th scope="col">Metric</th><th scope="col" class="text-end">Amount</th></tr></thead>
    <tbody>
    @foreach (var metric in Model.Money)
    {
        <tr><th scope="row" class="fw-normal">@metric.Label</th><td class="text-end">@Model.FormatMetric(metric, CultureInfo.CurrentCulture)</td></tr>
    }
    </tbody>
</table>
<h2 class="h5">Retail sales and refunds by payment method</h2>
<p>Use the online totals to reconcile retail transfers. Grooming cash and verified deposits appear above.</p>
<table class="table">
    <thead><tr><th scope="col">Metric</th><th scope="col" class="text-end">Amount</th></tr></thead>
    <tbody>
    @foreach (var metric in Model.RetailPayments)
    {
        <tr><th scope="row" class="fw-normal">@metric.Label</th><td class="text-end">@Model.FormatMetric(metric, CultureInfo.CurrentCulture)</td></tr>
    }
    </tbody>
</table>
<h2 class="h5">Shop activity</h2>
<table class="table">
    <thead><tr><th scope="col">Metric</th><th scope="col" class="text-end">Value</th></tr></thead>
    <tbody>
    @foreach (var metric in Model.Activity)
    {
        <tr><th scope="row" class="fw-normal">@metric.Label</th>
            <td class="text-end">@Model.FormatMetric(metric, CultureInfo.CurrentCulture)</td></tr>
    }
    </tbody>
</table>
